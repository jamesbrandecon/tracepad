# Select one provider. When omitted, Tracepad auto-selects a reachable Ollama
# server, then OpenAI, then OpenRouter.
TRACEPAD_PROVIDER=ollama

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
TRACEPAD_OLLAMA_MODEL=

# OpenAI
OPENAI_API_KEY=
TRACEPAD_OPENAI_MODEL=gpt-5.4-mini

# OpenRouter
OPENROUTER_API_KEY=
TRACEPAD_OPENROUTER_MODEL=
