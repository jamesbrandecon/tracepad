# Select a named profile from tracepad.yaml. When omitted, Tracepad uses the
# YAML default_profile or the first configured profile.
TRACEPAD_PROFILE=ollama

# Optional explicit YAML path. Project tracepad.yaml and the user config at
# ~/.config/tracepad/config.yaml are discovered automatically.
TRACEPAD_CONFIG=

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
TRACEPAD_OLLAMA_MODEL=

# OpenAI
OPENAI_API_KEY=
TRACEPAD_OPENAI_MODEL=gpt-5.4-mini

# OpenRouter
OPENROUTER_API_KEY=
TRACEPAD_OPENROUTER_MODEL=

# TRACEPAD_PROVIDER remains supported as a legacy provider/profile selector.
